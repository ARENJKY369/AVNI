{
  "name": "avni",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AVNI \u2014 natural-language interrogation of optical + SAR scenes. Frontend build with a mock analysis service, honest geodetic provenance, and a reproducible evidence harness.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "shots": "node scripts/shot.mjs",
    "shots:responsive": "node scripts/shot-responsive.mjs",
    "verify:location": "node scripts/verify-location.mjs",
    "verify:zoom": "node scripts/verify-zoom.mjs",
    "verify:segment": "node scripts/verify-segment.mjs",
    "verify:console": "node scripts/verify-console.mjs",
    "verify:a11y": "node scripts/a11y.mjs",
    "verify": "npm run verify:console && npm run verify:zoom && npm run verify:segment && npm run verify:location && npm run verify:a11y && npm run verify:features",
    "verify:features": "node scripts/verify-features.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cornerstonejs/codec-openjpeg": "^1.3.6",
    "@sparticuz/chromium": "^153.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.13.0",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "geotiff": "^3.0.5",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.49",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^3.4.17",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
